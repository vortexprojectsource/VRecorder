#include <windows.h>
#include "resource.h"

IDI_VR_APP  ICON   "../assets/vrecorder.ico"
IDB_VR_LOGO RCDATA "../assets/vrecorder.png"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     2,2,0,0
PRODUCTVERSION  2,2,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Vortex Open Source Project"
            VALUE "FileDescription",  "VRecorder - Lightweight Native OBS-Style Screen, Camera & Audio Studio"
            VALUE "FileVersion",      "2.2.0.0"
            VALUE "InternalName",     "VRecorder.exe"
            VALUE "LegalCopyright",   "Vortex Open Source Project"
            VALUE "OriginalFilename", "VRecorder.exe"
            VALUE "ProductName",      "VRecorder"
            VALUE "ProductVersion",   "2.2.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
